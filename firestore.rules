rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwnerOfEvent(eventId) {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/events/$(eventId)) &&
         get(/databases/$(database)/documents/events/$(eventId)).data.ownerId == request.auth.uid) ||
        (existsAfter(/databases/$(database)/documents/events/$(eventId)) &&
         getAfter(/databases/$(database)/documents/events/$(eventId)).data.ownerId == request.auth.uid)
      );
    }

    function isMemberOfEvent(eventId) {
      return isSignedIn() && (
        isOwnerOfEvent(eventId) ||
        exists(/databases/$(database)/documents/events/$(eventId)/members/$(request.auth.uid)) ||
        existsAfter(/databases/$(database)/documents/events/$(eventId)/members/$(request.auth.uid))
      );
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow create, update: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && incoming().id == userId;
    }

    // Events Root Collection
    match /events/{eventId} {
      allow get: if isSignedIn() && isValidId(eventId) && (
        resource.data.ownerId == request.auth.uid ||
        exists(/databases/$(database)/documents/events/$(eventId)/members/$(request.auth.uid))
      );

      // Secure query enforcer: enforces client must query by ownerId == request.auth.uid
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      allow create: if isSignedIn() && isValidId(eventId) &&
        incoming().ownerId == request.auth.uid &&
        incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 200 &&
        incoming().totalBudget is number && incoming().totalBudget >= 0;

      allow update: if isSignedIn() && isValidId(eventId) &&
        resource.data.ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId;

      allow delete: if isSignedIn() && isValidId(eventId) &&
        resource.data.ownerId == request.auth.uid;

      // Event Members Subcollection
      match /members/{memberId} {
        allow get, list: if isSignedIn() && isValidId(eventId) && (
          isOwnerOfEvent(eventId) || request.auth.uid == memberId
        );
        allow create, update, delete: if isSignedIn() && isValidId(eventId) && (
          isOwnerOfEvent(eventId) || request.auth.uid == memberId
        );
      }

      // Budget Categories Subcollection
      match /budgetCategories/{categoryId} {
        allow get, list: if isSignedIn() && isValidId(eventId) && isMemberOfEvent(eventId);
        allow create, update, delete: if isSignedIn() && isValidId(eventId) && (
          isOwnerOfEvent(eventId) || isMemberOfEvent(eventId)
        );
      }

      // Tasks Subcollection
      match /tasks/{taskId} {
        allow get, list: if isSignedIn() && isValidId(eventId) && isMemberOfEvent(eventId);
        allow create, update, delete: if isSignedIn() && isValidId(eventId) && (
          isOwnerOfEvent(eventId) || isMemberOfEvent(eventId)
        );
      }

      // Vendor Quotes Subcollection
      match /quotes/{quoteId} {
        allow get, list: if isSignedIn() && isValidId(eventId) && isMemberOfEvent(eventId);
        allow create, update, delete: if isSignedIn() && isValidId(eventId) && (
          isOwnerOfEvent(eventId) || isMemberOfEvent(eventId)
        );
      }

      // Change Proposals Subcollection
      match /changeProposals/{proposalId} {
        allow get, list: if isSignedIn() && isValidId(eventId) && isMemberOfEvent(eventId);
        allow create, update, delete: if isSignedIn() && isValidId(eventId) && isOwnerOfEvent(eventId);
      }
    }
  }
}
